rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }

    // Real-time leads and form field footprints collection
    match /leads/{leadId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Contact submissions collection (from contact form)
    match /contact_submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Legacy inquiries collection fallback
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Blog posts collection (CRUD for travel blog)
    match /blog_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Customer reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Users profile collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Vehicles and packages
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if true;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
