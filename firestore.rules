rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'waltairtravelsandcabs@gmail.com';
    }

    // Bookings collection
    // Public can create bookings. Admin can manage all. Signed-in users can read their own trips.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.customerEmail != null && request.auth.token.email != null && resource.data.customerEmail.lower() == request.auth.token.email.lower())
      ));
      allow update, delete: if isAdmin();
    }

    // Real-time leads and form field footprints collection
    // Public can create & track their active lead footprint. Only authorized admin can view/manage leads.
    match /leads/{leadId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // Contact submissions collection (from contact form)
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Inquiries collection fallback
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Blog posts collection (CRUD for travel blog)
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer reviews
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Users profile collection
    match /users/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Vehicles and packages
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
